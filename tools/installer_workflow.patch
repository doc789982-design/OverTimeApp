diff --git a/.github/workflows/build-windows.yml b/.github/workflows/build-windows.yml
index 8a83aab..8129b94 100644
--- a/.github/workflows/build-windows.yml
+++ b/.github/workflows/build-windows.yml
@@ -60,16 +60,34 @@ jobs:
           Compress-Archive -Path "dist\OVERTIMETAB\*" -DestinationPath "${{ steps.ver.outputs.zipname }}.zip"
           Get-Item "${{ steps.ver.outputs.zipname }}.zip" | Select-Object Name, @{N='МБ';E={[math]::Round($_.Length/1MB,1)}}
 
+      # ── Установщик ──────────────────────────────────────────────
+      # Релиз состоит из ДВУХ файлов, и оба обязательны:
+      #   *.exe — установщик для человека (заглушка + этот же zip);
+      #   *.zip — обновление для установленной программы (автообновление
+      #           ищет на релизе файл с .zip на конце — не убирайте его).
+      # Проверяет оба файла tools/publish_release.py — релиз без
+      # установщика опубликовать нельзя.
+      - name: Собрать заглушку установщика
+        run: pyinstaller --noconfirm --clean --distpath build_stub tools/installer_stub.spec
+
+      - name: Склеить установщик (заглушка + архив)
+        run: python tools/make_installer.py --stub build_stub/installer_stub.exe --zip "${{ steps.ver.outputs.zipname }}.zip" --out "${{ steps.ver.outputs.zipname }}.exe"
+        # ────────────────────────────────────────────────────────────
+
       - name: Загрузить сборку в Artifacts
         uses: actions/upload-artifact@v4
         with:
           name: ${{ steps.ver.outputs.zipname }}
-          path: ${{ steps.ver.outputs.zipname }}.zip
+          path: |
+            ${{ steps.ver.outputs.zipname }}.zip
+            ${{ steps.ver.outputs.zipname }}.exe
           retention-days: 30
 
       - name: Опубликовать релиз (если это тег)
         if: startsWith(github.ref, 'refs/tags/')
         uses: softprops/action-gh-release@v2
         with:
-          files: ${{ steps.ver.outputs.zipname }}.zip
+          files: |
+            ${{ steps.ver.outputs.zipname }}.zip
+            ${{ steps.ver.outputs.zipname }}.exe
           generate_release_notes: true
